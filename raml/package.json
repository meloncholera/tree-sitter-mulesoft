{
  "name": "tree-sitter-raml",
  "version": "0.1.1",
  "description": "RAML grammar for tree-sitter",
  "main": "bindings/node",
  "types": "bindings/node",
  "scripts": {
    "install": "node-gyp-build",
    "prestart": "npx --yes --package=tree-sitter-cli@0.27.0 -- tree-sitter build --wasm",
    "start": "npx --yes --package=tree-sitter-cli@0.27.0 -- tree-sitter playground",
    "test": "node --test bindings/node/*_test.js",
    "lint": "eslint grammar.js \"test/*.mjs\" \"bindings/node/*.js\"",
    "format": "prettier --write grammar.js \"test/*.mjs\" \"bindings/node/*.js\"",
    "format:check": "prettier --check grammar.js \"test/*.mjs\" \"bindings/node/*.js\""
  },
  "author": "M. Reifschneider",
  "license": "MIT",
  "dependencies": {
    "node-addon-api": "8.9.2",
    "node-gyp-build": "4.8.4"
  },
  "devDependencies": {
    "node-gyp": "13.0.2",
    "tree-sitter": "0.25.1"
  },
  "peerDependencies": {
    "tree-sitter": "^0.25.0"
  },
  "peerDependenciesMeta": {
    "tree-sitter": {
      "optional": true
    }
  },
  "gypfile": true,
  "directories": {
    "test": "test"
  },
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/meloncholera/tree-sitter-mulesoft.git",
    "directory": "raml"
  },
  "bugs": {
    "url": "https://github.com/meloncholera/tree-sitter-mulesoft/issues"
  },
  "homepage": "https://github.com/meloncholera/tree-sitter-mulesoft#readme",
  "keywords": [
    "parser",
    "raml",
    "yaml",
    "mulesoft",
    "tree-sitter"
  ],
  "files": [
    "grammar.js",
    "binding.gyp",
    "bindings/node/*",
    "queries/*",
    "src/**",
    "prebuilds/**",
    "tree-sitter.json",
    "NOTICE"
  ],
  "allowScripts": {
    "tree-sitter-cli@0.27.0": true,
    "tree-sitter@0.25.1": true
  }
}
