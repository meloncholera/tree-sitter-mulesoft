{
  "grammars": [
    {
      "name": "dataweave",
      "camelcase": "DataWeave",
      "scope": "source.dwl",
      "path": "dataweave",
      "file-types": [
        "dwl"
      ],
      "highlights": [
        "queries/highlights.scm"
      ]
    },
    {
      "name": "raml",
      "camelcase": "RAML",
      "scope": "source.raml",
      "path": "raml",
      "file-types": [
        "raml"
      ],
      "highlights": [
        "queries/highlights.scm"
      ]
    }
  ],
  "metadata": {
    "version": "0.1.1",
    "license": "MIT",
    "description": "Tree-sitter grammars for MuleSoft DataWeave and RAML",
    "authors": [
      {
        "name": "M. Reifschneider"
      }
    ],
    "links": {
      "repository": "git+https://github.com/meloncholera/tree-sitter-mulesoft.git"
    }
  },
  "bindings": {
    "c": true,
    "go": false,
    "node": true,
    "python": false,
    "rust": true,
    "swift": false
  }
}
